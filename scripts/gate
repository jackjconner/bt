#!/usr/bin/env bash
# gate — run a component-improvement-loop gate from your worktree, with TMPDIR
# already redirected off the RAM-backed /tmp and (for the timed bench) the
# machine bench lock held.
#
# This replaces the `cd <worktree> && . scripts/diskguard && <long command>`
# boilerplate that worker sub-agents otherwise repeat ~30× per round, and pins
# every gate to the *current* worktree (`git rev-parse --show-toplevel`) so a
# slipped cwd can't run a gate against the wrong tree.
#
#   scripts/gate lint                # ruff check + ruff format --check + ty check
#   scripts/gate test [paths...]     # pytest (default: full suite)
#                                    #   e.g. scripts/gate test etl/ tests/integration/
#   scripts/gate eval [extra...]     # evalgate vs the round golden
#                                    #   e.g. scripts/gate eval --tolerance 0
#                                    #        scripts/gate eval --allow-new-fields
#   scripts/gate consolidate-check [ref]   # the consolidate-round bar: diff THIS
#                                    #   tree's PipelineSummary against a freshly
#                                    #   computed `ref` (default main), exact. Use
#                                    #   this, not `eval --tolerance 0`, to prove a
#                                    #   removal changed nothing.
#   scripts/gate bench [args...]     # harness through the bench lock (clean timings)
#   scripts/gate all <component>     # lint, then test <component>/ + integration, then eval
#
# Run it from inside your worktree (the gate operates on whatever tree you're in).
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Redirect heavy temp off tmpfs (exports TMPDIR; refuses to proceed on tmpfs /
# low disk). Sourced so the export reaches the uv subprocesses below.
# shellcheck source=/dev/null
. "$ROOT/scripts/diskguard" >/dev/null

# The round golden lives in `.oversight/` (gitignored), which exists only in the
# PRIMARY checkout — a fresh worktree doesn't have it. Resolve it from the common
# git dir's parent (the primary worktree root) so a worker never hand-copies it
# in. In the primary checkout this is identical to ROOT.
PRIMARY_ROOT="$(dirname "$(cd "$(git rev-parse --git-common-dir)" && pwd)")"
GOLDEN="$PRIMARY_ROOT/.oversight/golden.json"

_sub="${1:-}"
shift 2>/dev/null || true

case "$_sub" in
  lint)
    uv run ruff check
    uv run ruff format --check
    uv run ty check
    ;;
  test)
    uv run pytest -q "$@"
    ;;
  eval)
    uv run python -m evalgate --golden "$GOLDEN" --field-tol backtest_p50_s=0.5 "$@"
    ;;
  consolidate-check)
    # The right bar for a *consolidate* round (pure dead-code removal must move
    # nothing). `eval --tolerance 0` is wrong here: the committed golden carries
    # pre-existing ~1e-16 fp-noise (a BLAS/build artifact present on clean main
    # too), so it flags spuriously. Instead compute `ref`'s summary FRESH in an
    # ephemeral worktree and diff this tree against it exactly — both runs share
    # this machine's BLAS, so the noise cancels and any remaining diff is real.
    # Wall-clock timing (backtest_p50_s) is the one field that legitimately varies
    # run-to-run, so it keeps a field-tol; every other field must be exact.
    ref="${1:-main}"
    _tmp="$(mktemp -d)"
    _wt="$_tmp/ref-tree"
    _ref_summary="$_tmp/ref_summary.json"
    trap 'git worktree remove --force "$_wt" 2>/dev/null || true; rm -rf "$_tmp"' EXIT
    echo "consolidate-check: computing '$ref' summary in an ephemeral worktree …"
    git worktree add --quiet --detach "$_wt" "$ref"
    ( cd "$_wt" && uv run python -m evalgate --save --golden "$_ref_summary" >/dev/null )
    echo "consolidate-check: diffing current tree vs '$ref' (exact) …"
    uv run python -m evalgate --golden "$_ref_summary" --tolerance 0 --field-tol backtest_p50_s=0.5
    ;;
  bench)
    scripts/bench uv run main.py "$@"
    ;;
  all)
    comp="${1:-}"
    if [ -z "$comp" ]; then
      echo "gate all: needs a component dir, e.g. scripts/gate all etl" >&2
      exit 2
    fi
    uv run ruff check
    uv run ruff format --check
    uv run ty check
    uv run pytest -q "$comp/" tests/integration/
    uv run python -m evalgate --golden "$GOLDEN" --field-tol backtest_p50_s=0.5
    ;;
  *)
    echo "usage: scripts/gate {lint|test|eval|bench|all} [args]" >&2
    exit 2
    ;;
esac
